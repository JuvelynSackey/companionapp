<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen (Android 11 and below): the logo centred on the brand cream.
     The Flutter BrandSplash continues it with the same logo at the same size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_cream" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
