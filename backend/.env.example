# Copy this file to .env and fill in real values.
# .env holds secrets and must never be committed or shared.

PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_companion
DB_USER=postgres
DB_PASSWORD=change_me

# Long random string used to sign login tokens.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Push notifications (Firebase Cloud Messaging) and Google Sign-In share this
# Firebase project and credential. Leave both off until the project exists;
# see docs/push-notifications.md and docs/google-sign-in.md.
FCM_ENABLED=false
GOOGLE_SIGN_IN_ENABLED=false
# The service-account key JSON from Firebase, on ONE line. Never commit it.
FIREBASE_SERVICE_ACCOUNT=
